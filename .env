# Read automatically by `docker compose` and shipped in the student zip.

# GitHub repository (owner/name, lowercase) that publishes the Jupyter image
# to ghcr.io/<REPO>. Update this when the repository moves; CI fails until it matches.
REPO=rumbledb/bigdata-exam-magic-box

# Jupyter image tag. Set to a version like 2026.11.03-a1b2c3d to pin it (e.g. for an exam).
JUPYTER_TAG=latest
