{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "description": "Every PR is built and smoke-tested on amd64 + arm64 by image.yml; merging publishes the image.",
    "extends": [
        "config:recommended",
        "customManagers:dockerfileVersions"
    ],
    "timezone": "Europe/Zurich",
    "labels": [
        "dependencies"
    ],
    "automerge": false,
    "docker-compose": {
        "description": "Off: docker-compose.yml only reaches students via a new release zip; update it by hand each semester",
        "enabled": false
    },
    "lockFileMaintenance": {
        "description": "Monthly: refresh all indirect Python packages in uv.lock, in one PR",
        "enabled": true,
        "extends": [
            "schedule:monthly"
        ]
    },
    "packageRules": [
        {
            "description": "Batch routine updates into one weekly PR",
            "matchUpdateTypes": [
                "minor",
                "patch",
                "pin",
                "digest"
            ],
            "groupName": "weekly dependency updates",
            "extends": [
                "schedule:weekly"
            ]
        },
        {
            "description": "Open separate major-update PRs for review without dashboard pre-approval",
            "matchUpdateTypes": [
                "major"
            ],
            "groupName": null,
            "dependencyDashboardApproval": false
        },
        {
            "description": "JSONiq: a separate PR per release, as soon as it is published",
            "matchPackageNames": [
                "jsoniq",
                "jsoniq-jupyterlab-extension",
                "jsoniq-language-server"
            ],
            "groupName": null,
            "schedule": [
                "at any time"
            ],
            "labels": [
                "dependencies",
                "jsoniq"
            ]
        },
        {
            "description": "Keep .python-version on Python 3.11; Renovate's pyenv manager updates patch versions",
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "python"
            ],
            "allowedVersions": "/^3\\.11\\./"
        }
    ]
}
