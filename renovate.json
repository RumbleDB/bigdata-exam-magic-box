{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "description": "Every PR is built and smoke-tested on amd64 + arm64 by image.yml; merging publishes the image.",
    "extends": [
        "config:recommended",
        "customManagers:dockerfileVersions"
    ],
    "timezone": "Europe/Zurich",
    "labels": [
        "dependencies"
    ],
    "docker-compose": {
        "description": "Off: docker-compose.yml only reaches students via a new release zip; update it by hand each semester",
        "enabled": false
    },
    "lockFileMaintenance": {
        "description": "Monthly: refresh all indirect Python packages in uv.lock, in one PR",
        "enabled": true,
        "extends": [
            "schedule:monthly"
        ]
    },
    "packageRules": [
        {
            "description": "Default: batch everything into one monthly PR",
            "matchPackageNames": [
                "*"
            ],
            "groupName": "monthly dependency updates",
            "extends": [
                "schedule:monthly"
            ]
        },
        {
            "description": "JSONiq: a separate PR per release, as soon as it is published",
            "matchPackageNames": [
                "jsoniq",
                "jsoniq-jupyterlab-extension",
                "jsoniq-language-server"
            ],
            "groupName": null,
            "schedule": [
                "at any time"
            ],
            "labels": [
                "dependencies",
                "jsoniq"
            ]
        },
        {
            "description": "Keep .python-version on Python 3.11; Renovate's pyenv manager updates patch versions",
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "python"
            ],
            "allowedVersions": "/^3\\.11\\./"
        },
        {
            "description": "Stay on Node 24 LTS",
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "node"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "enabled": false
        },
        {
            "description": "Major upgrades of Spark/RumbleDB stack need a human look at the cheatsheets first",
            "matchPackageNames": [
                "pyspark",
                "delta-spark",
                "jupyterlab"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "dependencyDashboardApproval": true
        }
    ]
}
